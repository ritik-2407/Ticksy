# ─── Database ────────────────────────────────────────────────────────────────
# Get this from Neon: https://neon.tech → New Project → Connection string
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host/ticksy?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Your app's URL (http://localhost:3000 in dev, https://yourapp.vercel.app in prod)
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (Phase 2) ──────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── OpenAI (Phase 6 — AI triage) ────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
