# ─── Database ────────────────────────────────────────────────────────────────
# Get this from Neon: https://neon.tech → New Project → Connection string
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host/ticksy?sslmode=require"

# ─── NextAuth v5 ─────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
# ⚠ NextAuth v5 uses AUTH_SECRET (not NEXTAUTH_SECRET). Set this in Vercel.
AUTH_SECRET="your-secret-here"

# Your app's production URL — used by NextAuth for OAuth callbacks and invite links.
# Dev: http://localhost:3000
# Prod: https://yourapp.vercel.app  ← must match the Vercel deployment URL exactly
AUTH_URL="http://localhost:3000"

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
#   → OAuth 2.0 Client IDs → Web application
#
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google      (local dev)
#   https://yourapp.vercel.app/api/auth/callback/google (production)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Get from: https://github.com/settings/developers → New OAuth App
# Authorization callback URL must be:
#   http://localhost:3000/api/auth/callback/github      (local dev)
#   https://yourapp.vercel.app/api/auth/callback/github (production)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ─── Invite email (Resend) ───────────────────────────────────────────────────
# Optional. Without both values, an admin gets a link to copy instead.
# From must be a sender you have verified in Resend (https://resend.com).
# RESEND_API_KEY="re_..."
# RESEND_FROM="Ticksy <invites@yourdomain.com>"
